{
  "$schema": "https://raw.githubusercontent.com/nicedoc/open-docs/main/tauri/tauri.conf.json",
  "productName": "amble",
  "version": "0.1.0",
  "identifier": "com.amble.flowtime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "amble",
        "width": 400,
        "height": 580,
        "minWidth": 320,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  }
}
